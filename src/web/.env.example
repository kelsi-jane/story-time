# Copy this file to .env.local and fill in your values.
# .env.local is gitignored and never committed.

# Your GitHub username — used to mock authentication in local dev.
VITE_DEV_AUTH_USERNAME=your-github-username

# Comma-separated list of GitHub usernames seeded into the admin whitelist on
# first load. The first entry is the primary admin. Keep this in sync with your
# Azure app settings for production builds.
VITE_INITIAL_ADMIN_USERNAMES=your-github-username

# Display name for the site, shown as the heading on the landing page.
VITE_SITE_NAME=Your Site Name

# One-line tagline shown under the site name on the landing page.
VITE_SITE_TAGLINE=A place for original fiction.
